#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 4
#define SCROLL 5
#define NUM 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q   &kp W   &kp E   &kp R   &kp T                                  &kp Y   &kp U   &kp I   &kp O   &kp N1
&kp A   &kp S   &kp D   &kp F   &kp G   &kp N6      &kp RIGHT_BRACKET  &kp H   &kp J   &kp K   &kp L   &kp N2
&kp Z   &kp X   &kp C   &kp V   &kp B   &kp N8      &kp N7             &kp N8  &kp N9  &kp N0  &kp N1  &kp E
&kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6      &kp N7             &kp N3                          &kp N3
            >;
        };

        SYMBOL {
            bindings = <
&kp NUMBER_1      &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5                           &kp N8            &kp N9         &kp MINUS         &kp EQUAL          &kp INT3
&kp CAPS          &kp N0        &trans        &kp NUMBER_6  &kp N7  &mkp MB4      &mkp MB5   &kp LEFT_BRACKET  &kp SEMICOLON  &kp SINGLE_QUOTE  &kp RIGHT_BRACKET  &kp BSLH
&kp LEFT_SHIFT    &trans        &trans        &trans        &trans  &trans        &kp COMMA  &kp PERIOD        &kp SLASH      &kp INT_RO        &kp RIGHT_CONTROL  &kp ENTER
&kp LEFT_CONTROL  &kp LEFT_WIN  &kp LEFT_ALT  &trans        &trans  &trans        &trans     &trans                                                                &kp LEFT_SHIFT
            >;
        };

        NUM {
            bindings = <
&kp TAB                &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_MINUS                                       &kp CARET         &trans    &mkp MB3        &trans     &kp DEL
&kp ASTERISK           &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp PLUS      &kp LC(LA(KP_DIVIDE))      &mkp MB4  &kp EXCLAMATION   &mkp MB1  &kp UP_ARROW    &mkp MB2   &trans
&mt EQUAL KP_NUMBER_0  &kp KP_N1        &kp KP_N2        &kp KP_NUMBER_3  &kp KP_EQUAL  &kp KP_MULTIPLY            &mkp MB5  &kp LEFT_BRACKET  &kp LEFT  &kp DOWN_ARROW  &kp RIGHT  &kp ENTER
&kp LEFT_CONTROL       &kp ESCAPE       &kp LEFT_ALT     &trans           &trans        &trans                     &trans    &kp DEL                                                &trans
            >;
        };

        FUNCTION {
            bindings = <
&kp ESC         &kp F7    &kp F8    &kp F9  &kp F12                      &trans   &trans    &trans    &trans           &kp ESC
&kp HOME        &kp F4    &kp F5    &kp F6  &kp F11  &trans      &trans  &trans   &kp CAPS  &kp UP    &trans           &trans
&kp LEFT_SHIFT  &kp F1    &kp F2    &kp F3  &kp F10  &trans      &trans  &trans   &kp LEFT  &kp DOWN  &kp RIGHT_ARROW  &trans
&kp LCTRL       &kp LGUI  &kp LALT  &trans  &trans   &trans      &trans  &kp DEL                                       &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        SCROLL_FUNCTION {
            bindings = <
&kp ESCAPE        &kp F7        &kp F8        &kp F9  &kp F12                      &trans      &trans  &trans  &trans  &trans
&kp CAPS          &kp F4        &kp F5        &kp F6  &kp F11  &trans      &trans  &trans      &trans  &trans  &trans  &trans
&kp LEFT_SHIFT    &kp F1        &kp F2        &kp F3  &kp F10  &trans      &trans  &trans      &trans  &trans  &trans  &kp ENTER
&kp LEFT_CONTROL  &kp LEFT_WIN  &kp LEFT_ALT  &trans  &trans   &trans      &trans  &kp DELETE                          &kp RIGHT_SHIFT
            >;
        };

        BLUETOOTH {
            bindings = <
&kp ESC           &trans  &trans  &trans  &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&kp HOME          &trans  &trans  &trans  &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&kp LEFT_SHIFT    &trans  &trans  &trans  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&kp LEFT_CONTROL  &trans  &trans  &trans  &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };

        layer_7 {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                       &trans  &trans  &trans  &trans  &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans                  &trans          &trans                   &trans   &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        layer_8 {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                       &trans  &trans  &trans  &trans  &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans                  &trans          &trans                   &trans   &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        layer_9 {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                       &trans  &trans  &trans  &trans  &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans                  &trans          &trans                   &trans   &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };
    };
};
