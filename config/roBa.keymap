#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 4
#define SCROLL 5
#define NUM 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q           &kp W      &kp E         &kp R         &kp T                                         &kp Y            &kp U  &kp I      &kp O      &kp ESCAPE
&kp A           &kp S      &kp D         &kp F         &kp G      &kp LG(N8)       &mkp MB3          &kp H            &kp J  &kp K      &kp L      &kp P
&kp Z           &kp X      &kp C         &kp V         &kp B      &kp PRCNT        &lt 5 LEFT_BRACE  &kp N            &kp M  &mkp LCLK  &mkp RCLK  &kp ENTER
&kp LEFT_SHIFT  &kp RCTRL  &kp LEFT_WIN  &kp LEFT_ALT  &lt 6 TAB  &lt 2 SPACE      &lt 1 SPACE       &lt 6 BACKSPACE                               &kp RIGHT_SHIFT
            >;
        };

        SYMBOL {
            bindings = <
&kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5                                    &kp N8      &kp N9     &kp N0            &kp MINUS          &kp EQUAL
&kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &kp DOLLAR    &kp PERCENT  &kp NUMBER_6      &kp N7     &trans      &trans     &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp RA(NON_US_BACKSLASH)
&trans           &trans        &trans        &trans        &trans       &trans            &kp COMMA  &kp PERIOD  &kp SLASH  &kp SEMICOLON     &kp SQT            &kp ENTER
&kp LEFT_SHIFT   &kp LCTRL     &kp LEFT_WIN  &kp LEFT_ALT  &trans       &trans            &trans     &trans                                                      &kp LEFT_SHIFT
            >;
        };

        ARROW_MOUSE {
            bindings = <
&kp HOME        &kp UP          &kp END          &trans        &trans                        &trans    &trans    &trans    &trans    &kp DEL
&kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans        &trans  &trans      &mkp MB4  &trans    &trans    &trans    &trans    &trans
&trans          &trans          &trans           &trans        &trans  &trans      &mkp MB5  &trans    &mkp MB1  &mkp MB3  &mkp MB2  &kp ENTER
&kp LEFT_SHIFT  &kp LCTRL       &kp LEFT_WIN     &kp LEFT_ALT  &trans  &trans      &mkp MB4  &mkp MB5                                &kp RIGHT_SHIFT
            >;
        };

        FUNCTION {
            bindings = <
&kp F1          &kp F2     &kp F3        &kp F4        &kp F5                       &trans   &trans    &trans    &trans           &kp ESC
&kp HOME        &kp F4     &kp F5        &kp F6        &kp F11  &trans      &trans  &trans   &kp CAPS  &kp UP    &trans           &trans
&kp CAPS        &kp F1     &kp F2        &kp F3        &kp F10  &trans      &trans  &trans   &kp LEFT  &kp DOWN  &kp RIGHT_ARROW  &trans
&kp LEFT_SHIFT  &kp RCTRL  &kp LEFT_WIN  &kp LEFT_ALT  &trans   &trans      &trans  &kp DEL                                       &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        SCROLL_FUNCTION {
            bindings = <
&kp ESCAPE        &kp F7        &kp F8        &kp F9  &kp F12                      &trans      &trans  &trans  &trans  &trans
&kp CAPS          &kp F4        &kp F5        &kp F6  &kp F11  &trans      &trans  &trans      &trans  &trans  &trans  &trans
&kp LEFT_SHIFT    &kp F1        &kp F2        &kp F3  &kp F10  &trans      &trans  &trans      &trans  &trans  &trans  &kp ENTER
&kp LEFT_CONTROL  &kp LEFT_WIN  &kp LEFT_ALT  &trans  &trans   &trans      &trans  &kp DELETE                          &kp RIGHT_SHIFT
            >;
        };

        BLUETOOTH {
            bindings = <
&kp F1          &kp F2        &kp F3        &kp F4        &kp F5                                 &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &kp F6      &kp F7       &trans  &trans  &trans   &trans   &trans
&kp CAPSLOCK    &trans        &trans        &trans        &trans        &trans      &bootloader  &trans  &trans  &trans   &trans   &bt BT_CLR
&kp LEFT_SHIFT  &kp LCTRL     &kp LEFT_WIN  &kp LEFT_ALT  &trans        &trans      &trans       &trans                            &bt BT_CLR_ALL
            >;
        };

        layer_7 {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                       &trans  &trans  &trans  &trans  &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans                  &trans          &trans                   &trans   &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        layer_8 {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                       &trans  &trans  &trans  &trans  &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans                  &trans          &trans                   &trans   &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        layer_9 {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                       &trans  &trans  &trans  &trans  &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans                  &trans          &trans                   &trans   &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };
    };
};
